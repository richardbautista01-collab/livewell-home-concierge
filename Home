<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>LiveWell Home Concierge | Peace of Mind for Families</title>

<meta name="description" content="LiveWell Home Concierge provides trusted home support, maintenance coordination, and peace of mind for families across the GTA and York Region.">


<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial, Helvetica, sans-serif;
}

body{
color:#1F2937;
line-height:1.6;
}


/* NAVIGATION */

nav{

background:#2F6B4F;
padding:20px 10%;
display:flex;
justify-content:space-between;
align-items:center;
color:white;
position:relative;

}


.logo img{

height:75px;
width:auto;

}


.nav-links{

display:flex;

}


nav a{

color:white;
text-decoration:none;
margin-left:25px;
font-weight:bold;

}


.menu-toggle{

display:none;
background:none;
border:none;
color:white;
font-size:32px;
cursor:pointer;

}


/* HERO */

.hero{

min-height:90vh;
display:flex;
align-items:center;
padding:80px 10%;

background:
linear-gradient(
rgba(0,0,0,.45),
rgba(0,0,0,.45)
),
url("hero.jpg") center/cover no-repeat;

color:white;

}


.hero-content{

max-width:800px;

}


.tagline{

font-size:22px;
margin-bottom:20px;

}


.hero h1{

font-size:58px;
line-height:1.1;
margin-bottom:25px;

}


.hero p{

font-size:20px;
margin-bottom:35px;

}


.button{

display:inline-block;
background:#2F6B4F;
color:white;
padding:16px 35px;
border-radius:30px;
text-decoration:none;
font-weight:bold;

}


/* SECTIONS */


.section{

padding:90px 10%;
text-align:center;

}


.section h2{

font-size:40px;
color:#2F6B4F;
margin-bottom:20px;

}


.services{

display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:30px;
margin-top:50px;

}


.card{

background:#F8F5F0;
padding:35px;
border-radius:18px;

}


.card h3{

color:#2F6B4F;
font-size:22px;
margin-bottom:15px;

}


/* HOW IT WORKS */


.steps{

display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:30px;
margin-top:50px;

}


.step{

padding:35px;
background:white;
border-radius:18px;
box-shadow:0 5px 20px rgba(0,0,0,.08);

}


.step span{

font-size:40px;
font-weight:bold;
color:#2F6B4F;

}


.step h3{

margin:15px 0;

}


/* MEMBERSHIP */


.membership{

background:#F8F5F0;
padding:90px 10%;
text-align:center;

}


.membership h2{

font-size:40px;
color:#2F6B4F;

}


.membership p{

font-size:20px;
max-width:750px;
margin:20px auto;

}


.price{

font-size:44px;
font-weight:bold;
color:#1E4534;
margin:30px;

}


.membership ul{

list-style:none;

}


.membership li{

font-size:18px;
margin:15px;

}


.membership .button{

background:#1E4534;

}


/* SERVICE AREA */


.area{

padding:70px 10%;
text-align:center;
background:#1E4534;
color:white;

}


.area h2{

font-size:38px;
margin-bottom:20px;

}


/* FOOTER */


footer{

background:#153526;
color:white;
padding:30px;
text-align:center;

}


/* MOBILE */

@media(max-width:768px){


nav{

padding:15px 6%;

}


.logo img{

height:55px;

}


.menu-toggle{

display:block;

}


.nav-links{

display:none;
position:absolute;
top:80px;
left:0;
width:100%;
background:#2F6B4F;
flex-direction:column;
text-align:center;
padding:20px 0;

}


.nav-links a{

margin:12px 0;

}


.nav-links.active{

display:flex;

}


.hero{

padding:60px 8%;

}


.hero h1{

font-size:38px;

}


.hero p{

font-size:18px;

}


.section h2,
.membership h2{

font-size:32px;

}

}

</style>

</head>
